# キー名のみ。実際の値は .env / .env.local（Git 管理外）にのみ置く。
# チャット・ログ・コミットに値を出さない。
#
# .env と .env.* は .gitignore 済み（.env.example だけが例外）。
# このファイルには実値を書かない。コミットされる。

# --- Supabase（本プロジェクト専用の新規 Project。既存 Project は使わない） ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Worker 専用。Web には置かない
SUPABASE_SERVICE_ROLE_KEY=
# Worker が接続する DSN。最小権限ロールで接続し、DB owner では接続しない。
# scripts/load_snapshot_direct.py と Phase 2 の worker が読む。
SURGE_DB_URL=

# --- ローカル開発（supabase start の出力を貼る。ローカル専用） ---
LOCAL_SUPABASE_URL=
LOCAL_SUPABASE_DB_URL=

# --- Object Storage（Phase 2.0 で Cloudflare R2 に決定 / D-03b） ---
# 'r2' か 'local:<path>'（開発・テスト用）。既定値は無く、未設定ならジョブは失敗する。
SURGE_OBJECT_STORE=local:./.local/phase21
# R2 の API トークンは**当該バケットのみ**に絞った Object Read & Write で作る。
# アカウント全体のトークンを使わない。
SURGE_R2_ACCOUNT_ID=
SURGE_R2_BUCKET=
SURGE_R2_ACCESS_KEY_ID=
SURGE_R2_SECRET_ACCESS_KEY=
# 省略時は https://<account id>.r2.cloudflarestorage.com
SURGE_R2_ENDPOINT=

# --- 市場データ Provider（Phase 2.0 で決定） ---
# J-Quants。プラン名は market.provider_plans の値と一致させる。
# プランは保存する全オブジェクトに記録され、後のダウングレード時に
# 何を削除する義務があるかを決める。
SURGE_JQUANTS_API_KEY=
SURGE_JQUANTS_PLAN=Standard

# EODHD。プラン名は market.provider_plans の値と一字一句同じにする。
SURGE_EODHD_API_TOKEN=
SURGE_EODHD_PLAN=EOD Historical Data - All World

# OpenFIGI はキー無しでも動く（25 req/分）。キーがあると 25 req/6秒・100 jobs/req。
SURGE_OPENFIGI_API_KEY=

# --- その他 ---
# 送信する User-Agent に載せる連絡先（SEC が明示を求めている）
SURGE_CONTACT_EMAIL=

# --- LLM（Phase 7） ---
LLM_API_KEY=
