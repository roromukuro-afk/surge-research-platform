# キー名のみ。実際の値は .env（Git 管理外）にのみ置く。チャット・ログ・コミットに値を出さない。

# --- Supabase（本プロジェクト専用の新規 Project。既存 Project は使わない） ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Worker 専用。Web には置かない
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- ローカル開発（supabase start の出力を貼る。ローカル専用） ---
LOCAL_SUPABASE_URL=
LOCAL_SUPABASE_DB_URL=

# --- Object Storage（Phase 2 で選定） ---
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=

# --- 市場データ Provider（用途別。Phase 1 はマスタ用のみ） ---
JQUANTS_API_KEY=
US_MASTER_PROVIDER_API_KEY=

# --- LLM（Phase 7） ---
LLM_API_KEY=
