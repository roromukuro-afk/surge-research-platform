# このリポジトリは Public。秘密情報・研究データ・Raw データは絶対に commit しない（CLAUDE.md §4）

# --- secrets / credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
service-account*.json
credentials*.json
*credentials*.json
secrets.*
.secrets/
.npmrc
.pypirc
.netrc

# --- node / next ---
node_modules/
.next/
out/
.vercel/

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- research / raw / market data（正本は Private な Supabase / Object Storage） ---
/.local/
/data/
/local-data/
/exports/
/artifacts/
/raw/
*.parquet
*.feather
*.arrow
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3
*.zst
*.csv.gz
*.jsonl.gz
*.xlsx
*.xls
# The web shadow's fixture is made-up data (scripts/make_shadow_fixture.py, D-279), kept in the
# shadow's own format, which compresses some artifacts.
!apps/web/fixtures/shadow/**/*.jsonl.gz

# --- database dumps ---
*.dump
*.backup
*.bak
*.sql.gz
dump*.sql
backup*.sql

# --- supabase local ---
supabase/.branches/
supabase/.temp/
.supabase/

# --- logs ---
*.log
logs/

# --- os / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

