{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "shadow": {
      "root": ".",
      "entrypoint": "pyproject.toml"
    }
  },
  "rewrites": [
    { "source": "/api/shadow/(.*)", "destination": { "service": "shadow" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [
    { "path": "/api/shadow/cron/noop", "schedule": "0 14 * * *" }
  ]
}
